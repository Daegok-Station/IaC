#################################################################################
####################################### ecr #####################################
#################################################################################

resource "aws_ecr_repository" "ecr" {
    name = var.ecr_name
    image_tag_mutability = "MUTABLE"         # 최신태그 업데이트 가능 (CI 환경 기본값)

    image_scanning_configuration {
        scan_on_push = true                    # 이미지 push 시 자동 스캔
    }
}
